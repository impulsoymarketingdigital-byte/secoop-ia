# ============================================================
#  JIREHAI Backend - Configuración
# ============================================================

# Servidor
PORT=3000

# Base de Datos
DB_PATH=./jirehai.db

# JWT - Seguridad
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# SECOP II API
SECOP_API_URL=https://www.datos.gov.co/resource/p6dx-8zbt.json

# SECOP II Credenciales (opcional — permite descargar documentos automáticamente)
# Si se configuran, el sistema hace login automático en community.secop.gov.co
# y descarga los pliegos, estudios previos, presupuestos y cotizaciones del proceso
SECOP_USER=tu_usuario_secop
SECOP_PASS=tu_contraseña_secop

# OpenAI (Opcional - para análisis IA)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Email - SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@jirehai.com

# Frontend
FRONTEND_URL=http://localhost:8080

# WOMPI — Pasarela de pagos (Colombia)
# Obtén tus llaves en: https://comercios.wompi.co/
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_KEY=test_integrity_XXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXX
WOMPI_PRICE_PROFESIONAL=7900000
WOMPI_PRICE_EMPRESARIAL=14900000

# Admin - Credenciales por defecto
ADMIN_EMAIL=admin@jirehai.com
ADMIN_PASSWORD=admin2025
